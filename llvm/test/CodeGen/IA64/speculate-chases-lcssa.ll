entry:
  br label %outer

outer:
  br label %first

first:
  %p = phi ptr [ %p.next, %first ], [ %a, %outer ]
  %p.next = load ptr, ptr %p, align 8
  %p.done = icmp eq ptr %p.next, null
  br i1 %p.done, label %between, label %first

between:
  br i1 %skip, label %skipped, label %second

skipped:
  br label %latch

second:
  %q = phi ptr [ %q.next, %second ], [ %b, %between ]
  %q.next = load ptr, ptr %q, align 8
  %q.done = icmp eq ptr %q.next, null
  br i1 %q.done, label %latch, label %second

latch:
  %q.lcssa = phi ptr [ %q, %second ], [ null, %skipped ]
  call void @use(ptr %q.lcssa)
