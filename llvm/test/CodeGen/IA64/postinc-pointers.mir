# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=ia64-unknown-linux-gnu -run-pass=ia64-postinc-pointers \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# y[i] += x[i] and y[i + 1] += x[i + 1]. Each of the six accesses steps a
# pointer of its own. The loads at no offset step the pointers that were
# there, and the four adds go.
---
name: offsets
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: offsets
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r32, $r33, $r34
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr = COPY $r32
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr = COPY $r33
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr = COPY $r34
  ; CHECK-NEXT:   SET_LC [[COPY2]], implicit-def dead $ar65
  ; CHECK-NEXT:   [[ADDS:%[0-9]+]]:gr = ADDS 8, [[COPY]], $p0
  ; CHECK-NEXT:   [[ADDS1:%[0-9]+]]:gr = ADDS 8, [[COPY1]], $p0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr = PHI [[ADDS1]], %bb.0, %24, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %21, %bb.1
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:gr = PHI [[ADDS]], %bb.0, %19, %bb.1
  ; CHECK-NEXT:   [[PHI3:%[0-9]+]]:gr = PHI [[ADDS]], %bb.0, %17, %bb.1
  ; CHECK-NEXT:   [[PHI4:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %4, %bb.1
  ; CHECK-NEXT:   [[PHI5:%[0-9]+]]:gr = PHI [[COPY1]], %bb.0, %6, %bb.1
  ; CHECK-NEXT:   [[LD8_i:%[0-9]+]]:gr, [[LD8_i1:%[0-9]+]]:gr = LD8_i [[PHI5]], 16, 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   [[LD8_i2:%[0-9]+]]:gr, [[LD8_i3:%[0-9]+]]:gr = LD8_i [[PHI4]], 16, 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:gr = ADD [[LD8_i]], [[LD8_i2]], $p0
  ; CHECK-NEXT:   [[ST8_i:%[0-9]+]]:gr = ST8_i [[PHI1]], [[ADD]], 16, 0, $p0 :: (store (s64))
  ; CHECK-NEXT:   [[LD8_i4:%[0-9]+]]:gr, [[LD8_i5:%[0-9]+]]:gr = LD8_i [[PHI]], 16, 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   [[LD8_i6:%[0-9]+]]:gr, [[LD8_i7:%[0-9]+]]:gr = LD8_i [[PHI3]], 16, 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   [[ADD1:%[0-9]+]]:gr = ADD [[LD8_i4]], [[LD8_i6]], $p0
  ; CHECK-NEXT:   [[ST8_i1:%[0-9]+]]:gr = ST8_i [[PHI2]], [[ADD1]], 16, 0, $p0 :: (store (s64))
  ; CHECK-NEXT:   BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
  ; CHECK-NEXT:   BRUNCOND %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0
  bb.0:
    liveins: $r32, $r33, $r34
    %0:gr = COPY $r32
    %1:gr = COPY $r33
    %2:gr = COPY $r34
    SET_LC %2, implicit-def dead $ar65

  bb.1:
    %10:gr = PHI %0, %bb.0, %11, %bb.1
    %12:gr = PHI %1, %bb.0, %13, %bb.1
    %20:gr = LD8 %12, 0, $p0 :: (load (s64))
    %21:gr = LD8 %10, 0, $p0 :: (load (s64))
    %22:gr = ADD %20, %21, $p0
    ST8 %10, %22, 0, $p0 :: (store (s64))
    %30:gr = ADDS 8, %12, $p0
    %31:gr = ADDS 8, %10, $p0
    %32:gr = LD8 %30, 0, $p0 :: (load (s64))
    %33:gr = LD8 %31, 0, $p0 :: (load (s64))
    %34:gr = ADD %32, %33, $p0
    ST8 %31, %34, 0, $p0 :: (store (s64))
    %11:gr = ADDS 16, %10, $p0
    %13:gr = ADDS 16, %12, $p0
    BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
    BRUNCOND %bb.2

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
---
# Only accesses at an offset use the pointer, which goes with its add.
name: offset_only
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: offset_only
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r32, $r33
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr = COPY $r32
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr = COPY $r33
  ; CHECK-NEXT:   SET_LC [[COPY1]], implicit-def dead $ar65
  ; CHECK-NEXT:   [[ADDS:%[0-9]+]]:gr = ADDS 4, [[COPY]], $p0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr = PHI [[ADDS]], %bb.0, %10, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gr = PHI [[ADDS]], %bb.0, %8, %bb.1
  ; CHECK-NEXT:   [[LD4_i:%[0-9]+]]:gr, [[LD4_i1:%[0-9]+]]:gr = LD4_i [[PHI1]], 8, 0, $p0 :: (load (s32))
  ; CHECK-NEXT:   [[ST4_i:%[0-9]+]]:gr = ST4_i [[PHI]], [[LD4_i]], 8, 0, $p0 :: (store (s32))
  ; CHECK-NEXT:   BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
  ; CHECK-NEXT:   BRUNCOND %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0
  bb.0:
    liveins: $r32, $r33
    %0:gr = COPY $r32
    %2:gr = COPY $r33
    SET_LC %2, implicit-def dead $ar65

  bb.1:
    %10:gr = PHI %0, %bb.0, %11, %bb.1
    %30:gr = ADDS 4, %10, $p0
    %32:gr = LD4 %30, 0, $p0 :: (load (s32))
    ST4 %30, %32, 0, $p0 :: (store (s32))
    %11:gr = ADDS 8, %10, $p0
    BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
    BRUNCOND %bb.2

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
---
# The stepped pointer is returned, which the load can step as well as the add.
name: live_out
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: live_out
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r32, $r33
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr = COPY $r32
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr = COPY $r33
  ; CHECK-NEXT:   SET_LC [[COPY1]], implicit-def dead $ar65
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %7, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[LD8_i:%[0-9]+]]:gr, [[LD8_i1:%[0-9]+]]:gr = LD8_i [[PHI1]], 8, 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   [[ADDS:%[0-9]+]]:gr = ADDS 1, [[LD8_i]], $p0
  ; CHECK-NEXT:   [[ST8_i:%[0-9]+]]:gr = ST8_i [[PHI]], [[ADDS]], 8, 0, $p0 :: (store (s64))
  ; CHECK-NEXT:   BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
  ; CHECK-NEXT:   BRUNCOND %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r8 = COPY [[LD8_i1]]
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0, implicit $r8
  bb.0:
    liveins: $r32, $r33
    %0:gr = COPY $r32
    %2:gr = COPY $r33
    SET_LC %2, implicit-def dead $ar65

  bb.1:
    %10:gr = PHI %0, %bb.0, %11, %bb.1
    %20:gr = LD8 %10, 0, $p0 :: (load (s64))
    %21:gr = ADDS 1, %20, $p0
    ST8 %10, %21, 0, $p0 :: (store (s64))
    %11:gr = ADDS 8, %10, $p0
    BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
    BRUNCOND %bb.2

  bb.2:
    $r8 = COPY %11
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
---
# The stepped pointer is stored before the first access, which cannot step it.
name: read_first
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: read_first
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r32, $r33, $r34
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr = COPY $r32
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr = COPY $r33
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr = COPY $r34
  ; CHECK-NEXT:   SET_LC [[COPY2]], implicit-def dead $ar65
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %4, %bb.1
  ; CHECK-NEXT:   [[ADDS:%[0-9]+]]:gr = ADDS 8, [[PHI]], $p0
  ; CHECK-NEXT:   ST8 [[COPY1]], [[ADDS]], 0, $p0 :: (store (s64))
  ; CHECK-NEXT:   [[LD8_:%[0-9]+]]:gr = LD8 [[PHI]], 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
  ; CHECK-NEXT:   BRUNCOND %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0
  bb.0:
    liveins: $r32, $r33, $r34
    %0:gr = COPY $r32
    %1:gr = COPY $r33
    %2:gr = COPY $r34
    SET_LC %2, implicit-def dead $ar65

  bb.1:
    %10:gr = PHI %0, %bb.0, %11, %bb.1
    %11:gr = ADDS 8, %10, $p0
    ST8 %1, %11, 0, $p0 :: (store (s64))
    %20:gr = LD8 %10, 0, $p0 :: (load (s64))
    BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
    BRUNCOND %bb.2

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
---
# A step of 512 does not fit in an access.
name: far
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: far
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r32, $r33
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr = COPY $r32
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr = COPY $r33
  ; CHECK-NEXT:   SET_LC [[COPY1]], implicit-def dead $ar65
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[ADDS:%[0-9]+]]:gr = ADDS 8, [[PHI]], $p0
  ; CHECK-NEXT:   [[LD8_:%[0-9]+]]:gr = LD8 [[ADDS]], 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   [[ADDS1:%[0-9]+]]:gr = ADDS 512, [[PHI]], $p0
  ; CHECK-NEXT:   BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
  ; CHECK-NEXT:   BRUNCOND %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0
  bb.0:
    liveins: $r32, $r33
    %0:gr = COPY $r32
    %2:gr = COPY $r33
    SET_LC %2, implicit-def dead $ar65

  bb.1:
    %10:gr = PHI %0, %bb.0, %11, %bb.1
    %30:gr = ADDS 8, %10, $p0
    %20:gr = LD8 %30, 0, $p0 :: (load (s64))
    %11:gr = ADDS 512, %10, $p0
    BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
    BRUNCOND %bb.2

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
---
# Volatile and predicated accesses are left as they are, and with them the
# adds they need.
name: left
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: left
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r32, $r33, $r34, $p6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr = COPY $r32
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr = COPY $r33
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr = COPY $r34
  ; CHECK-NEXT:   SET_LC [[COPY2]], implicit-def dead $ar65
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $p6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %4, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gr = PHI [[COPY1]], %bb.0, %6, %bb.1
  ; CHECK-NEXT:   [[ADDS:%[0-9]+]]:gr = ADDS 8, [[PHI]], $p0
  ; CHECK-NEXT:   [[LD8_:%[0-9]+]]:gr = LD8 [[ADDS]], 0, $p0 :: (volatile load (s64))
  ; CHECK-NEXT:   [[LD8_1:%[0-9]+]]:gr = LD8 [[PHI]], 0, $p0 :: (volatile load (s64))
  ; CHECK-NEXT:   [[ADDS1:%[0-9]+]]:gr = ADDS 16, [[PHI]], $p0
  ; CHECK-NEXT:   [[ADDS2:%[0-9]+]]:gr = ADDS 8, [[PHI1]], $p0
  ; CHECK-NEXT:   [[LD8_2:%[0-9]+]]:gr = LD8 [[ADDS2]], 0, $p6 :: (load (s64))
  ; CHECK-NEXT:   [[ADDS3:%[0-9]+]]:gr = ADDS 16, [[PHI1]], $p0
  ; CHECK-NEXT:   BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
  ; CHECK-NEXT:   BRUNCOND %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0
  bb.0:
    liveins: $r32, $r33, $r34, $p6
    %0:gr = COPY $r32
    %1:gr = COPY $r33
    %2:gr = COPY $r34
    SET_LC %2, implicit-def dead $ar65

  bb.1:
    liveins: $p6
    %10:gr = PHI %0, %bb.0, %11, %bb.1
    %12:gr = PHI %1, %bb.0, %13, %bb.1
    %30:gr = ADDS 8, %10, $p0
    %20:gr = LD8 %30, 0, $p0 :: (volatile load (s64))
    %21:gr = LD8 %10, 0, $p0 :: (volatile load (s64))
    %11:gr = ADDS 16, %10, $p0
    %31:gr = ADDS 8, %12, $p0
    %22:gr = LD8 %31, 0, $p6 :: (load (s64))
    %13:gr = ADDS 16, %12, $p0
    BRLOOP %bb.1, 0, implicit-def dead $ar65, implicit $ar65
    BRUNCOND %bb.2

  bb.2:
    BR_RET $b0, 0, 1, 0, $p0
...
---
# n = n->next: the load of next steps n for the load at offset 28, but the
# loop goes on from the pointer it loads, not from n + 28, so the access at
# offset 16 keeps its add.
name: load_next
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: load_next
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r32
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr = COPY $r32
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr = COPY $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr = PHI [[COPY1]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:gr = PHI [[COPY]], %bb.0, %5, %bb.1
  ; CHECK-NEXT:   [[ADDS:%[0-9]+]]:gr = ADDS 16, [[PHI1]], $p0
  ; CHECK-NEXT:   [[LD4_:%[0-9]+]]:gr = LD4 [[ADDS]], 0, $p0 :: (load (s32))
  ; CHECK-NEXT:   [[LD8_i:%[0-9]+]]:gr, [[LD8_i1:%[0-9]+]]:gr = LD8_i [[PHI1]], 28, 0, $p0 :: (load (s64))
  ; CHECK-NEXT:   [[LD4_1:%[0-9]+]]:gr = LD4 [[LD8_i1]], 0, $p0 :: (load (s32))
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:gr = ADD [[LD4_]], [[PHI]], $p0
  ; CHECK-NEXT:   [[ADD1:%[0-9]+]]:gr = ADD [[ADD]], [[LD4_1]], $p0
  ; CHECK-NEXT:   BRCCi %bb.1, 1, [[LD8_i]], 0, implicit-def dead $p6, implicit-def dead $p7
  ; CHECK-NEXT:   BRUNCOND %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $r8 = COPY [[ADD1]]
  ; CHECK-NEXT:   BR_RET $b0, 0, 1, 0, $p0, implicit $r8
  bb.0:
    liveins: $r32
    %1:gr = COPY $r32
    %5:gr = COPY $r0

  bb.1:
    %0:gr = PHI %5, %bb.0, %2, %bb.1
    %10:gr = PHI %1, %bb.0, %3, %bb.1
    %11:gr = ADDS 16, %10, $p0
    %12:gr = LD4 %11, 0, $p0 :: (load (s32))
    %3:gr, %18:gr = LD8_i %10, 28, 0, $p0 :: (load (s64))
    %19:gr = LD4 %18, 0, $p0 :: (load (s32))
    %20:gr = ADD %12, %0, $p0
    %2:gr = ADD %20, %19, $p0
    BRCCi %bb.1, 1, %3, 0, implicit-def dead $p6, implicit-def dead $p7
    BRUNCOND %bb.2

  bb.2:
    $r8 = COPY %2
    BR_RET $b0, 0, 1, 0, $p0, implicit $r8
...
